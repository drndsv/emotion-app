{
  "compilerOptions": {
    "module": "ESNext",
    "moduleResolution": "bundler",
    "target": "es2022",
    "lib": ["es2022"],
    "baseUrl": "..",
    "paths": {
      "@emotion-app/shared": ["libs/shared/src/index.ts"]
    },
    "esModuleInterop": true,
    "noImplicitReturns": true,
    "noUnusedLocals": true,
    "sourceMap": true,
    "strict": true,
    "skipLibCheck": true
  },
  "compileOnSave": true,
  "include": ["src", "../libs/shared/src"]
}
